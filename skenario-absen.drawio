        </mxCell>
        <mxCell id="8sZrL5v9ihG1iYNmOiwl-50" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=24;fontFamily=Helvetica;" value="Recap All data for today" vertex="1">
