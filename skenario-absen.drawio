        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-23" parent="1" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;fontStyle=1;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size: 72px;&quot;&gt;Flowchart ABSN - Mesin Absen&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="1395" x="-705" y="-1090" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-26" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="605" width="214" x="-705" y="-950" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;rotation=-90;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size: 72px;&quot;&gt;Start&lt;/font&gt;" vertex="1">
          <mxGeometry height="125" width="220" x="-708" y="-710" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-29" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=light-dark(#FFFFFF,#FFFFFF);fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="68" x="-705" y="170" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-31" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Helvetica;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Main.go&lt;/h1&gt;&lt;p&gt;&lt;code&gt;main.go&lt;/code&gt;&lt;span class=&quot;&quot;&gt; adalah backend sistem absensi yang &lt;br&gt;berjalan di terminal Linux ARMbian dengan antarmuka TUI (Terminal User &lt;br&gt;Interface) menggunakan library &lt;/span&gt;&lt;code&gt;tcell&lt;/code&gt;&lt;span class=&quot;&quot;&gt;.&lt;br&gt; Aplikasi ini berfungsi sebagai mesin penerima input ID karyawan (baik &lt;br&gt;melalui scan QR atau ketik manual) yang kemudian divalidasi terhadap &lt;br&gt;file &lt;/span&gt;&lt;code&gt;data.json&lt;/code&gt;&lt;span class=&quot;&quot;&gt; lokal untuk mendapatkan nama dan divisi karyawan. Setelah validasi, data dikirim via HTTP POST ke endpoint &lt;/span&gt;&lt;code&gt;absen.gs&lt;/code&gt;&lt;span class=&quot;&quot;&gt;&lt;br&gt; (Google Apps Script) yang bertindak sebagai otoritas pusat untuk &lt;br&gt;mencatat absensi ke Google Sheets dengan logika lengkap termasuk &lt;br&gt;pengecekan hari libur, penentuan shift, deteksi Sholat Jumat untuk &lt;br&gt;karyawan laki-laki, dan perhitungan keterlambatan. Aplikasi juga &lt;br&gt;memiliki fitur auto-sweep otomatis setiap jam 23:00 WIB untuk menandai &lt;br&gt;karyawan yang tidak absen, logging harian ke file &lt;/span&gt;&lt;code&gt;.log&lt;/code&gt;&lt;span class=&quot;&quot;&gt;,&lt;br&gt; debounce 2 detik untuk mencegah double scan, serta scheduler yang &lt;br&gt;berjalan di background untuk menjaga konsistensi data. Tampilan terminal&lt;br&gt; menampilkan informasi real-time seperti nama karyawan, divisi, waktu &lt;br&gt;absen, status, dan jam/ tanggal saat ini, dengan kontrol keyboard &lt;br&gt;sederhana (Enter untuk submit ID, Q untuk keluar, L untuk melihat log &lt;br&gt;harian).&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="335" width="440" x="-610" y="155" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-32" parent="1" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/png,;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="51" width="51" x="-696.5" y="189.5" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-34" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=light-dark(#FFFFFF,#FFFFFF);fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="68" x="-50" y="170" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-35" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Helvetica;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Code.gs&lt;/h1&gt;&lt;p&gt;&lt;span class=&quot;&quot;&gt;file Google Apps Script (&lt;/span&gt;&lt;code&gt;absen.gs&lt;/code&gt;&lt;span class=&quot;&quot;&gt;, &lt;/span&gt;&lt;code&gt;user.gs&lt;/code&gt;&lt;span class=&quot;&quot;&gt;, dan &lt;/span&gt;&lt;code&gt;admin.gs&lt;/code&gt;&lt;span class=&quot;&quot;&gt;)&lt;br&gt; membentuk lapisan backend berbasis cloud yang berfungsi sebagai &lt;br&gt;otoritas pusat dan penyimpanan data sistem absensi, dengan masing-masing&lt;br&gt; endpoint melayani klien yang berbeda sesuai prinsip separation of &lt;br&gt;concerns. &lt;/span&gt;&lt;code&gt;absen.gs&lt;/code&gt;&lt;span class=&quot;&quot;&gt; menerima POST dari &lt;/span&gt;&lt;code&gt;main.go&lt;/code&gt;&lt;span class=&quot;&quot;&gt;&lt;br&gt; untuk memproses absensi karyawan dengan logika lengkap—termasuk &lt;br&gt;validasi hari libur dari MasterData, deteksi Sholat Jumat untuk karyawan&lt;br&gt; laki-laki (skip Ishoma), penentuan shift berdasarkan divisi (Shift 1 &lt;br&gt;jam 08:00, Shift 2 GH jam 09:00, Shift 2 GC/HTC jam 10:00), perhitungan &lt;br&gt;keterlambatan dengan toleransi 10 menit, bom waktu untuk sesi terlewat, &lt;br&gt;dan auto-sweep 23:00 WIB—kemudian mencatatnya ke sheet harian 14 kolom &lt;br&gt;di Google Sheets. &lt;/span&gt;&lt;code&gt;user.gs&lt;/code&gt;&lt;span class=&quot;&quot;&gt; melayani &lt;/span&gt;&lt;code&gt;mobile.html&lt;/code&gt;&lt;span class=&quot;&quot;&gt;&lt;br&gt; dengan endpoint GET untuk check absensi, riwayat izin, dan riwayat &lt;br&gt;libur, serta POST untuk menambahkan izin/sakit (dengan warna kuning di &lt;br&gt;sheet) dan mengganti hari libur sementara, tanpa akses ke fitur CRUD &lt;br&gt;atau penghapusan data. &lt;/span&gt;&lt;code&gt;admin.gs&lt;/code&gt;&lt;span class=&quot;&quot;&gt; menyediakan full management untuk &lt;/span&gt;&lt;code&gt;desktop.html&lt;/code&gt;&lt;span class=&quot;&quot;&gt;&lt;br&gt; melalui endpoint GET (users, absen per tanggal, izin, libur, stats) dan&lt;br&gt; POST (save_user, delete_user, sync_absen, add_izin, switch_libur, &lt;br&gt;clear_izin, clear_libur, reset_all, eod_sweep), dengan MasterData &lt;br&gt;sebagai sumber otoritas karyawan (ID, Nama, Divisi, Gender, Libur) yang &lt;br&gt;terpusat sehingga semua perubahan data karyawan terintegrasi secara &lt;br&gt;real-time di seluruh komponen sistem.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="405" width="440" x="45" y="155" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-40" parent="1" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/png,;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="38" width="38" x="-35" y="196" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-42" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="1720" width="370" x="1210" y="-1120" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-45" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="500" width="605" x="555" y="100" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-47" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=light-dark(#FFFFFF,#FFFFFF);fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="68" x="616" y="170" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-48" parent="1" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/png,;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="37" width="37" x="631.5" y="196.5" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-49" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Helvetica;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Data.json&lt;/h1&gt;&lt;p&gt;&lt;code&gt;data.json&lt;/code&gt;&lt;span class=&quot;&quot;&gt; adalah file konfigurasi lokal yang&lt;br&gt; berisi daftar master karyawan dalam format JSON array of objects, &lt;br&gt;dengan setiap objek memiliki field &lt;/span&gt;&lt;code&gt;id&lt;/code&gt;&lt;span class=&quot;&quot;&gt;, &lt;/span&gt;&lt;code&gt;name&lt;/code&gt;&lt;span class=&quot;&quot;&gt;, &lt;/span&gt;&lt;code&gt;divisi&lt;/code&gt;&lt;span class=&quot;&quot;&gt;, &lt;/span&gt;&lt;code&gt;gender&lt;/code&gt;&lt;span class=&quot;&quot;&gt;, dan &lt;/span&gt;&lt;code&gt;libur&lt;/code&gt;&lt;span class=&quot;&quot;&gt;—berfungsi sebagai sumber data cepat (cache) untuk &lt;/span&gt;&lt;code&gt;main.go&lt;/code&gt;&lt;span class=&quot;&quot;&gt;&lt;br&gt; di sisi backend Linux ARMbian agar proses validasi ID karyawan bisa &lt;br&gt;dilakukan secara lokal tanpa harus selalu memanggil API Google Apps &lt;br&gt;Script, sehingga mengurangi latency dan ketergantungan pada koneksi &lt;br&gt;internet saat scanning. File ini dimuat saat &lt;/span&gt;&lt;code&gt;main.go&lt;/code&gt;&lt;span class=&quot;&quot;&gt; pertama kali dijalankan dan disimpan dalam memory map (&lt;/span&gt;&lt;code&gt;karyawanList&lt;/code&gt;&lt;span class=&quot;&quot;&gt;)&lt;br&gt; untuk akses O(1), dan digunakan untuk menampilkan informasi nama serta &lt;br&gt;divisi karyawan di layar terminal sebelum data dikirim ke &lt;/span&gt;&lt;code&gt;absen.gs&lt;/code&gt;&lt;span class=&quot;&quot;&gt; untuk pencatatan final. Meskipun &lt;/span&gt;&lt;code&gt;data.json&lt;/code&gt;&lt;span class=&quot;&quot;&gt; menjadi sumber cepat untuk tampilan dan validasi awal, otoritas final tetap berada di MasterData Google Sheets (via &lt;/span&gt;&lt;code&gt;.gs&lt;/code&gt;&lt;span class=&quot;&quot;&gt;) sehingga jika ada perubahan karyawan (tambah/edit/hapus) melalui &lt;/span&gt;&lt;code&gt;admin.gs&lt;/code&gt;&lt;span class=&quot;&quot;&gt; atau &lt;/span&gt;&lt;code&gt;desktop.html&lt;/code&gt;&lt;span class=&quot;&quot;&gt;, data di &lt;/span&gt;&lt;code&gt;data.json&lt;/code&gt;&lt;span class=&quot;&quot;&gt; harus diperbarui secara manual oleh admin untuk menjaga konsistensi tampilan di &lt;/span&gt;&lt;code&gt;main.go&lt;/code&gt;&lt;span class=&quot;&quot;&gt;—karena &lt;/span&gt;&lt;code&gt;main.go&lt;/code&gt;&lt;span class=&quot;&quot;&gt; tidak memiliki mekanisme sinkronisasi otomatis dengan MasterData, berbeda dengan &lt;/span&gt;&lt;code&gt;mobile.html&lt;/code&gt;&lt;span class=&quot;&quot;&gt; dan &lt;/span&gt;&lt;code&gt;desktop.html&lt;/code&gt;&lt;span class=&quot;&quot;&gt; yang selalu mengambil data langsung dari Google Apps Script via API. File ini juga digunakan oleh &lt;/span&gt;&lt;code&gt;main.go&lt;/code&gt;&lt;span class=&quot;&quot;&gt; untuk mode inspeksi (&lt;/span&gt;&lt;code&gt;go run . -check &amp;lt;id&amp;gt;&lt;/code&gt;&lt;span class=&quot;&quot;&gt;)&lt;br&gt; yang memungkinkan admin mengecek keberadaan ID karyawan tanpa harus &lt;br&gt;menjalankan proses absensi penuh, serta menjadi sumber data saat build &lt;br&gt;dan deployment awal sistem di lingkungan Linux ARMbian.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="405" width="440" x="710" y="155" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-50" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="460" width="1150" x="-760" y="650" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-51" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Helvetica;" value="&lt;div&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;&lt;span&gt;go mod init nama-init&lt;br&gt;go get github.com/gdamore/tcell/v2&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="1052.5" x="-710" y="770" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-56" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="460" width="1166" x="414" y="650" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-57" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontColor=light-dark(default, #00ff00);fontFamily=Helvetica;" value="&lt;font style=&quot;font-size: 48px; color: light-dark(rgb(0, 0, 0), rgb(51, 255, 51));&quot;&gt;Prompt Initial Golang&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="507" x="-710" y="680" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-58" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Helvetica;" value="&lt;font style=&quot;font-size: 36px;&quot;&gt;cordova create absn-mobile com.absn.mobile ABSN&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;cd absn-mobile&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;cordova platform add android&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;cordova build android&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;cp /path/to/mobile.html www/index.html&lt;/font&gt;" vertex="1">
          <mxGeometry height="290" width="1052.5" x="470.75" y="760" as="geometry" />
        </mxCell>
        <mxCell id="uHnJ9WGhvt6EAWQ6iDkA-59" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontColor=light-dark(default, #00ff00);fontFamily=Helvetica;" value="&lt;font style=&quot;font-size: 48px; color: light-dark(rgb(0, 0, 0), rgb(51, 255, 51));&quot;&gt;Prompt Cordova&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="507" x="470.75" y="680" as="geometry" />
        </mxCell>
      </root>
